# Runtime
APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
VITE_ACCOUNT_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
LEGAL_TERMS_VERSION=
LEGAL_PRIVACY_VERSION=
RELEASE_ID=local

# Email delivery webhook. Test mode never sends mail and must not be used in production.
EMAIL_DELIVERY_MODE=
EMAIL_VERIFICATION_WEBHOOK_URL=
EMAIL_VERIFICATION_WEBHOOK_SECRET=

# Production PostgreSQL/PostGIS adapter
DATABASE_URL=postgresql://flightforge:replace-me@localhost:5432/flightforge
POSTGRES_USER=flightforge
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_DB=flightforge

# Supabase production target. Never expose the service-role key to browser code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local demonstration sign-in. Keep disabled in production.
DEMO_AUTH_ENABLED=true
DEMO_AUTH_SECRET=replace-with-at-least-32-random-characters

# Hosted role mapping (comma-separated exact emails)
PLATFORM_ADMIN_EMAILS=
COURSE_OWNER_EMAILS=
EVENT_COORDINATOR_EMAILS=
LEAGUE_ADMIN_EMAILS=

# Future providers remain disabled until configured.
MAP_PROVIDER=provider-neutral
MAPBOX_ACCESS_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AI_PROVIDER=mock
OPENAI_API_KEY=
# Backward-compatible alias; prefer OPENAI_API_KEY for new environments.
AI_API_KEY=
AI_MODEL=gpt-5.6
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
AI_REALTIME_MODEL=gpt-realtime-2.1
AI_REALTIME_VOICE=marin
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
MEDIA_SCANNER_URL=
MEDIA_SCANNER_TOKEN=
MEDIA_SANITIZATION_CALLBACK_SECRET=
TRANSCODING_PROVIDER=
STRIPE_CONNECT_CLIENT_ID=
RETENTION_JOB_SECRET=
