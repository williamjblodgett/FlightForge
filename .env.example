# Runtime
APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production PostgreSQL/PostGIS adapter
DATABASE_URL=postgresql://flightforge:replace-me@localhost:5432/flightforge
POSTGRES_USER=flightforge
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_DB=flightforge

# Local demonstration sign-in. Keep disabled in production.
DEMO_AUTH_ENABLED=true
DEMO_AUTH_SECRET=replace-with-at-least-32-random-characters

# Hosted role mapping (comma-separated exact emails)
PLATFORM_ADMIN_EMAILS=
COURSE_OWNER_EMAILS=

# Future providers remain disabled until configured.
MAP_PROVIDER=provider-neutral
MAPBOX_ACCESS_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AI_PROVIDER=mock
AI_API_KEY=
